{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/login",
        "http://localhost:3000/login?mode=sign-up",
        "http://localhost:3000/privacy",
        "http://localhost:3000/terms"
      ],
      "startServerCommand": "SCHEMA_VALIDATION_MODE=warn npm run start",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 30000,
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox",
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.55 }],
        "categories:accessibility": ["error", { "minScore": 0.86 }],
        "categories:best-practices": ["error", { "minScore": 0.86 }],
        "categories:seo": ["warn", { "minScore": 0.8 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./data/engineering-proof-artifacts/lighthouse"
    }
  }
}
