NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

QA_EMAIL=qa@example.com
QA_PASSWORD=replace-with-a-real-qa-password
INTERNAL_ADMIN_EMAILS=ops@example.com,admin@example.com
ALLOW_BILLING_ADMIN_OVERRIDE=false
BILLING_ADMIN_OVERRIDE_EMAILS=owner@example.com
INTERNAL_SYSTEM_JOBS_SECRET=replace-with-a-long-random-cron-secret
# Vercel Cron can also provide CRON_SECRET. Keep at least one internal runner secret configured.
CRON_SECRET=

AI_PROVIDER=openai
AI_API_KEY=your-ai-api-key
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

OPENAI_API_KEY=your-openai-api-key
OPENAI_IMAGE_MODEL=gpt-image-1.5
ALLOW_OPENAI_IMAGE_GENERATION=false

MEDIA_GENERATION_PROVIDER=higgsfield
HF_CREDENTIALS=your-higgsfield-key-id:your-higgsfield-key-secret
HF_API_KEY=
HF_API_SECRET=
ALLOW_HIGGSFIELD_IMAGE_GENERATION=false
ALLOW_HIGGSFIELD_VIDEO_GENERATION=false
HIGGSFIELD_IMAGE_MODEL=marketing_studio_image
HIGGSFIELD_VIDEO_MODEL=marketing_studio_video
HIGGSFIELD_UGC_VIDEO_MODEL=soul_cast
HIGGSFIELD_VIDEO_FALLBACK_MODEL=seedance_2_0
HIGGSFIELD_IMAGE_DAILY_LIMIT=10
HIGGSFIELD_VIDEO_DAILY_LIMIT=2

NEXT_PUBLIC_APP_URL=https://your-app.example.com
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

META_AD_ACCOUNT_ID=your-meta-ad-account-id
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=https://your-app.example.com/api/integrations/meta/callback
META_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret
META_SCOPES=ads_management,ads_read,business_management
META_EXECUTION_MODE=sandbox

STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_STARTER_PRICE_ID=price_starter
STRIPE_PRO_PRICE_ID=price_pro
STRIPE_GROWTH_PRICE_ID=price_growth

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INTERNAL_LEAD_SMS_ENABLED=false
SMS_MOCK_MODE=false
TEST_SMS_MODE=

HEYGEN_API_KEY=your-heygen-api-key
HEYGEN_AVATAR_ID=your-heygen-avatar-id
HEYGEN_VOICE_ID=your-heygen-voice-id
ALLOW_HEYGEN_VIDEO_GENERATION=false

ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id
